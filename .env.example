# Copy to .env and adjust. Every setting is optional.

# ---------------------------------------------------------------- database
# PostgreSQL (start one with: docker compose up -d db)
DATABASE_URL=postgresql+psycopg://samsung:samsung@localhost:5432/samsung_phones
# Remove DATABASE_URL to fall back to a local SQLite file (data/samsung_phones.db).

# ---------------------------------------------------------------- LLM
# auto | huggingface | ollama | transformers | openai | openai_compatible | none
# "auto" picks HF_TOKEN -> a running Ollama -> OPENAI_API_KEY; with none of them the
# system still answers, using grounded template text instead of LLM prose.
LLM_PROVIDER=auto

# Hugging Face Inference Providers (open-source models, OpenAI-compatible router).
# Needs Inference Provider credits on the account (HTTP 402 = out of credits).
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxx
# LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507   # or Qwen/Qwen2.5-72B-Instruct, ...

# Groq (free tier, open-source models, OpenAI-compatible) - tested with qwen/qwen3.8-27b;
# openai/gpt-oss-120b also works. Model list: https://console.groq.com/docs/models
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=qwen/qwen3.8-27b

# Ollama (local): `ollama pull llama3.1` then LLM_PROVIDER=ollama (or auto)
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.1:8b

# In-process Hugging Face model (pip install -r requirements-local-llm.txt)
# LLM_PROVIDER=transformers
# LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# OpenAI or any OpenAI-compatible server (vLLM, LM Studio, Groq, ...)
# OPENAI_API_KEY=sk-...
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=...

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LLM_TIMEOUT=120

# ---------------------------------------------------------------- RAG embeddings
# auto | fastembed | lexical  (lexical = offline hashed vectors, no model download)
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------- scraper
SCRAPE_DELAY=5
SCRAPE_MAX_PAGES=15
